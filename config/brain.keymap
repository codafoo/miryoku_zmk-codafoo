#include "../miryoku/custom_config.h"
#include "../miryoku/mapping/40/brain.h"
#include "../miryoku/miryoku.dtsi"

/ {
    combos {
        compatible = "zmk,combos";
        combo_tab {
            timeout-ms = <50>;
            key-positions = <23 24>;  // D + Z keys in Night layout
            bindings = <&kp TAB>;
            layers = <0 1 2 10>;      // BASE, EXTRA, TAP, ALT layers
        };
    };
};