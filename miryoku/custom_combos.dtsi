// Custom combos shared across all keyboards

/ {
    combos {
        compatible = "zmk,combos";
        combo_tab {
            timeout-ms = <50>;
            key-positions = <23 24>;  // D + Z keys
            bindings = <&kp TAB>;
            layers = <0 1 2 10>;      // BASE, EXTRA, TAP, ALT layers
        };
    };
};
